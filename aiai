<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>大富豪オンライン</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #2d3748; color: white; overflow: hidden; touch-action: manipulation; }
        .card {
            width: 60px; height: 85px; background: white; color: black; border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1); display: flex; flex-direction: column;
            justify-content: space-between; padding: 4px; font-weight: bold; user-select: none;
            cursor: pointer; transition: transform 0.1s; position: relative;
        }
        .card.selected { transform: translateY(-15px); border: 2px solid #3b82f6; box-shadow: 0 0 10px #3b82f6; }
        .card.red { color: #e11d48; }
        .card.black { color: #1f2937; }
        .card .suit { font-size: 1.2rem; line-height: 1; }
        .card .rank { font-size: 1.2rem; line-height: 1; text-align: center; }
        .card .rank-bottom { transform: rotate(180deg); }
        .card.joker { justify-content: center; align-items: center; color: #9333ea; font-size: 1.5rem;}
        
        .hand-container { display: flex; flex-wrap: wrap; justify-content: center; gap: -20px; padding: 20px 10px 0; }
        .hand-container .card { margin-left: -15px; }
        .hand-container .card:first-child { margin-left: 0; }
        
        .player-info { background: rgba(0,0,0,0.5); padding: 8px 12px; border-radius: 12px; display: inline-block; min-width: 120px; text-align: center; }
        .player-info.active-turn { border: 2px solid #fbbf24; box-shadow: 0 0 10px #fbbf24; }
        
        /* Modal */
        #modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 50; justify-content: center; align-items: center; }
        #modal-overlay.active { display: flex; }
        
        #toast { position: fixed; top: 20px; left: 50%; transform: translateX(-50%); background: #ef4444; padding: 10px 20px; border-radius: 20px; display: none; z-index: 60; transition: opacity 0.3s; }
    </style>
</head>
<body class="h-screen w-screen flex flex-col">

    <!-- Toast Notification -->
    <div id="toast" class="text-white font-bold shadow-lg"></div>

    <!-- Login/Lobby Screen -->
    <div id="lobby-screen" class="flex-1 flex flex-col items-center justify-center bg-gray-900 z-10 absolute inset-0">
        <h1 class="text-5xl font-bold text-yellow-400 mb-8 tracking-widest drop-shadow-lg">大富豪</h1>
        <div class="bg-gray-800 p-8 rounded-2xl shadow-2xl w-full max-w-md text-center border border-gray-700">
            <h2 class="text-2xl mb-4 font-semibold">プレイヤー名</h2>
            <input type="text" id="player-name" placeholder="プレイヤー名を入力" class="w-full p-3 rounded bg-gray-700 border-none focus:ring-2 focus:ring-blue-500 mb-6 text-white text-lg" maxlength="10">
            
            <div id="room-actions">
                <button id="create-room-btn" class="w-full bg-green-600 hover:bg-green-500 text-white font-bold py-3 px-4 rounded-lg text-lg transition-colors shadow-lg mb-4">新しく部屋を作る</button>
                
                <div class="relative flex py-3 items-center">
                    <div class="flex-grow border-t border-gray-600"></div>
                    <span class="flex-shrink-0 mx-4 text-gray-400 text-sm">または</span>
                    <div class="flex-grow border-t border-gray-600"></div>
                </div>

                <div class="flex gap-2">
                    <input type="text" id="room-id-input" placeholder="ルームID" class="w-2/3 p-3 rounded bg-gray-700 border-none focus:ring-2 focus:ring-blue-500 text-white uppercase text-lg" maxlength="6">
                    <button id="join-room-btn" class="w-1/3 bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-4 rounded-lg text-lg transition-colors shadow-lg">参加</button>
                </div>
            </div>
            
            <div id="room-status" class="mt-6 hidden">
                <div class="bg-gray-700 p-3 rounded-lg mb-4 flex justify-between items-center border border-gray-600">
                    <span class="text-gray-300 text-sm">ルームID:</span>
                    <span id="display-room-id" class="text-2xl font-mono font-bold text-yellow-400 tracking-widest"></span>
                    <button id="copy-room-id" class="bg-gray-600 hover:bg-gray-500 p-2 rounded text-xs transition">コピー</button>
                </div>
                <h3 class="text-lg text-gray-300 mb-2 border-b border-gray-600 pb-1">待機中のプレイヤー (<span id="player-count">0</span>/4)</h3>
                <ul id="player-list" class="space-y-2 mb-6 text-left"></ul>
                <button id="start-btn" class="w-full bg-yellow-500 hover:bg-yellow-400 text-gray-900 font-bold py-3 px-4 rounded-lg text-lg transition-colors hidden shadow-lg">ゲーム開始</button>
                <p id="waiting-msg" class="text-sm text-gray-400 mt-2">他のプレイヤーを待っています...</p>
            </div>
        </div>
    </div>

    <!-- Game Screen -->
    <div id="game-screen" class="hidden flex-1 flex-col h-full relative">
        <!-- Top Status Bar -->
        <div class="bg-gray-800 p-2 flex justify-between items-center shadow-md z-10">
            <div id="revolution-indicator" class="text-red-500 font-bold text-xl animate-pulse hidden border border-red-500 px-3 rounded bg-red-900/30">🔥 革命状態 🔥</div>
            <div id="game-message" class="text-lg font-bold text-blue-300 text-center flex-1"></div>
            <button id="leave-btn" class="bg-gray-600 hover:bg-gray-500 px-3 py-1 rounded text-sm transition">退出</button>
        </div>

        <!-- Main Game Area -->
        <div class="flex-1 relative flex flex-col justify-between p-4 pb-2">
            
            <!-- Other Players (Top Area) -->
            <div id="opponents-container" class="flex justify-around items-start h-24 mt-2">
                <!-- Dynamically populated -->
            </div>

            <!-- Table (Center Area) -->
            <div class="flex-1 flex flex-col items-center justify-center relative">
                <div id="table-info" class="absolute top-1/4 text-gray-400 text-sm"></div>
                <div id="table-cards" class="flex gap-2 justify-center items-center scale-125 transition-all">
                    <!-- Cards on table -->
                </div>
                <div id="table-status-msg" class="absolute bottom-1/4 text-yellow-400 font-bold text-2xl drop-shadow-md"></div>
            </div>

            <!-- Action Buttons -->
            <div class="flex justify-center gap-4 mb-2 z-10">
                <button id="pass-btn" class="bg-gray-600 hover:bg-gray-500 disabled:opacity-50 text-white font-bold py-3 px-8 rounded-full text-lg shadow-lg transition transform active:scale-95">パス</button>
                <button id="play-btn" class="bg-blue-600 hover:bg-blue-500 disabled:opacity-50 text-white font-bold py-3 px-8 rounded-full text-lg shadow-lg transition transform active:scale-95">出す</button>
            </div>

            <!-- My Hand -->
            <div class="h-32 bg-gray-800/50 rounded-xl relative">
                <div id="my-hand" class="hand-container absolute bottom-4 left-0 w-full">
                    <!-- Cards -->
                </div>
            </div>
            
            <!-- My Info -->
            <div class="absolute bottom-4 left-4">
                <div id="my-player-info" class="player-info">
                    <div class="font-bold text-blue-300" id="my-name">You</div>
                    <div class="text-sm">残り: <span id="my-card-count">0</span>枚</div>
                    <div id="my-rank" class="text-yellow-400 font-bold hidden"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Result Modal -->
    <div id="modal-overlay">
        <div class="bg-gray-800 p-8 rounded-2xl max-w-md w-full text-center border border-gray-600 shadow-2xl">
            <h2 class="text-3xl font-bold text-yellow-400 mb-6">ゲーム終了</h2>
            <div id="result-list" class="space-y-3 mb-6 text-lg"></div>
            <button id="back-to-lobby-btn" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-4 rounded-lg">ロビーに戻る</button>
        </div>
    </div>

    <!-- Firebase Logic -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, getDoc, updateDoc, onSnapshot, runTransaction } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Environment globals
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'daifugo-app';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};
        const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;

        // Initialize Firebase
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        // State
        let userId = null;
        let roomDocRef = null;
        let roomState = null;
        let unsubscribeRoom = null;
        let selectedCards = [];
        let currentRoomId = null;

        // Constants
        const MAX_PLAYERS = 4;
        const SUITS = ['S', 'H', 'D', 'C'];
        
        // Helper: Show Toast Error
        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.style.display = 'block';
            setTimeout(() => { toast.style.opacity = 0; setTimeout(() => { toast.style.display = 'none'; toast.style.opacity = 1; }, 300); }, 3000);
        }

        // Initialize Auth
        async function initAuth() {
            try {
                if (initialAuthToken) {
                    await signInWithCustomToken(auth, initialAuthToken);
                } else {
                    await signInAnonymously(auth);
                }
                userId = auth.currentUser.uid;
                setupUIEventListeners();
            } catch (error) {
                console.error("Auth error:", error);
                showToast("認証に失敗しました。");
            }
        }

        // Setup DOM Listeners
        function setupUIEventListeners() {
            document.getElementById('create-room-btn').addEventListener('click', createRoom);
            document.getElementById('join-room-btn').addEventListener('click', joinRoom);
            document.getElementById('copy-room-id').addEventListener('click', copyRoomId);
            document.getElementById('start-btn').addEventListener('click', startGame);
            document.getElementById('leave-btn').addEventListener('click', leaveRoom);
            document.getElementById('pass-btn').addEventListener('click', handlePass);
            document.getElementById('play-btn').addEventListener('click', handlePlay);
            document.getElementById('back-to-lobby-btn').addEventListener('click', resetToLobby);
        }

        // 6桁のランダムなルームIDを生成
        function generateRoomId() {
            const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
            let result = '';
            for (let i = 0; i < 6; i++) {
                result += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            return result;
        }

        // ルームIDのコピー
        function copyRoomId() {
            if (!currentRoomId) return;
            const tempInput = document.createElement("input");
            tempInput.value = currentRoomId;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand("copy");
            document.body.removeChild(tempInput);
            showToast("ルームIDをコピーしました！");
        }

        function startListening() {
            if (unsubscribeRoom) unsubscribeRoom();
            unsubscribeRoom = onSnapshot(roomDocRef, (docSnap) => {
                if (docSnap.exists()) {
                    roomState = docSnap.data();
                    render();
                }
            }, (error) => {
                console.error("Listen error:", error);
                showToast("通信エラーが発生しました。");
            });
        }

        // Actions
        async function createRoom() {
            if (!userId) return;
            const nameInput = document.getElementById('player-name').value.trim();
            const playerName = nameInput || `Player_${userId.substring(0,4)}`;
            
            try {
                currentRoomId = generateRoomId();
                roomDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'rooms', currentRoomId);
                
                await setDoc(roomDocRef, {
                    players: [{ id: userId, name: playerName, cards: [], finishedRank: null, passed: false }],
                    status: 'waiting', table: [], turnIndex: 0, isRevolution: false, passCount: 0, trickWinnerId: null
                });
                
                document.getElementById('room-actions').style.display = 'none';
                document.getElementById('room-status').classList.remove('hidden');
                document.getElementById('display-room-id').textContent = currentRoomId;
                
                startListening();
            } catch (e) {
                console.error(e);
                showToast("部屋の作成に失敗しました。");
            }
        }

        async function joinRoom() {
            if (!userId) return;
            const nameInput = document.getElementById('player-name').value.trim();
            const playerName = nameInput || `Player_${userId.substring(0,4)}`;
            const inputId = document.getElementById('room-id-input').value.trim().toUpperCase();
            
            if (!inputId || inputId.length !== 6) {
                showToast("正しいルームIDを入力してください。");
                return;
            }

            try {
                currentRoomId = inputId;
                roomDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'rooms', currentRoomId);

                await runTransaction(db, async (transaction) => {
                    const roomDoc = await transaction.get(roomDocRef);
                    if (!roomDoc.exists()) throw "部屋が見つかりません。";
                    const data = roomDoc.data();
                    
                    if (data.status !== 'waiting' && !data.players.some(p => p.id === userId)) {
                        throw "ゲームは既に進行中です。";
                    }
                    if (data.players.length >= MAX_PLAYERS && !data.players.some(p => p.id === userId)) {
                        throw "満室です。";
                    }
                    
                    let newPlayers = [...data.players];
                    if (!newPlayers.some(p => p.id === userId)) {
                        newPlayers.push({ id: userId, name: playerName, cards: [], finishedRank: null, passed: false });
                    }
                    transaction.update(roomDocRef, { players: newPlayers });
                });
                
                document.getElementById('room-actions').style.display = 'none';
                document.getElementById('room-status').classList.remove('hidden');
                document.getElementById('display-room-id').textContent = currentRoomId;
                
                startListening();
            } catch (e) {
                showToast(typeof e === 'string' ? e : "入室に失敗しました。");
            }
        }

        function generateDeck() {
            let deck = [];
            for (let s of SUITS) {
                for (let r = 1; r <= 13; r++) deck.push({ suit: s, rank: r });
            }
            deck.push({ suit: 'JOKER', rank: 0 }); // Joker 1
            deck.push({ suit: 'JOKER', rank: 0 }); // Joker 2
            
            // Shuffle
            for (let i = deck.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [deck[i], deck[j]] = [deck[j], deck[i]];
            }
            return deck;
        }

        // Sorting cards: 3 is weakest, 2 is strongest, Joker is max. (Sort visual only, not actual strength logic)
        function sortHand(cards) {
            const getVal = (c) => {
                if (c.suit === 'JOKER') return 100;
                if (c.rank === 2) return 15;
                if (c.rank === 1) return 14;
                return c.rank;
            };
            return cards.sort((a, b) => getVal(a) - getVal(b) || a.suit.localeCompare(b.suit));
        }

        async function startGame() {
            try {
                await runTransaction(db, async (transaction) => {
                    const roomDoc = await transaction.get(roomDocRef);
                    const data = roomDoc.data();
                    if (data.players.length < 2) throw "2人以上必要です。";
                    
                    const deck = generateDeck();
                    let players = [...data.players];
                    players.forEach(p => { p.cards = []; p.finishedRank = null; p.passed = false; });
                    
                    // Deal cards
                    let pIdx = 0;
                    deck.forEach(card => {
                        players[pIdx].cards.push(card);
                        pIdx = (pIdx + 1) % players.length;
                    });
                    
                    players.forEach(p => p.cards = sortHand(p.cards));
                    
                    transaction.update(roomDocRef, {
                        status: 'playing',
                        players: players,
                        table: [],
                        turnIndex: 0,
                        isRevolution: false,
                        passCount: 0,
                        trickWinnerId: null,
                        tableStatus: "ゲーム開始！"
                    });
                });
            } catch (e) {
                showToast(e);
            }
        }

        async function leaveRoom() {
             try {
                if (unsubscribeRoom) {
                    unsubscribeRoom();
                    unsubscribeRoom = null;
                }
                if (roomDocRef) {
                    await runTransaction(db, async (transaction) => {
                        const roomDoc = await transaction.get(roomDocRef);
                        if (!roomDoc.exists()) return;
                        const data = roomDoc.data();
                        const newPlayers = data.players.filter(p => p.id !== userId);
                        if (newPlayers.length === 0) {
                            transaction.delete(roomDocRef);
                        } else {
                            // If game is active and someone leaves, reset to lobby for everyone
                            transaction.update(roomDocRef, { 
                                players: newPlayers, 
                                status: data.status === 'playing' ? 'waiting' : data.status,
                                table: []
                            });
                        }
                    });
                }
                
                currentRoomId = null;
                roomDocRef = null;
                roomState = null;

                document.getElementById('lobby-screen').style.display = 'flex';
                document.getElementById('game-screen').classList.add('hidden');
                document.getElementById('room-actions').style.display = 'block';
                document.getElementById('room-status').classList.add('hidden');
                document.getElementById('room-id-input').value = '';
                
            } catch (e) {
                console.error(e);
            }
        }

        async function resetToLobby() {
            document.getElementById('modal-overlay').classList.remove('active');
            await leaveRoom();
        }

        // Logic Helpers
        function getCardStrength(card, isRev) {
            if (card.suit === 'JOKER') return 99; // Joker always strongest
            let base = card.rank;
            if (base === 1) base = 14;
            if (base === 2) base = 15;
            // Base ranges from 3 to 15.
            if (isRev) {
                // Revolution: 3 becomes strongest (after Joker), 2 becomes weakest.
                return 18 - base; 
            }
            return base;
        }

        function getNextTurn(currentIdx, players) {
            let next = (currentIdx + 1) % players.length;
            let safety = 0;
            while (players[next].finishedRank !== null && safety < 10) {
                next = (next + 1) % players.length;
                safety++;
            }
            return next;
        }

        async function handlePass() {
            if (!roomState || roomState.players[roomState.turnIndex].id !== userId) return;
            selectedCards = [];
            
            try {
                await runTransaction(db, async (transaction) => {
                    const roomDoc = await transaction.get(roomDocRef);
                    let data = roomDoc.data();
                    
                    let newPlayers = [...data.players];
                    let myIdx = data.turnIndex;
                    newPlayers[myIdx].passed = true;
                    
                    let newPassCount = data.passCount + 1;
                    let nextTurn = getNextTurn(data.turnIndex, newPlayers);
                    let activePlayersCount = newPlayers.filter(p => p.finishedRank === null).length;
                    
                    let newTable = data.table;
                    let tableStatus = "パス";

                    // If everyone else passed
                    if (newPassCount >= activePlayersCount - 1) {
                        newTable = []; // clear table
                        newPassCount = 0;
                        newPlayers.forEach(p => p.passed = false); // reset pass status
                        
                        // Trick goes to the last person who played (trickWinner)
                        if (data.trickWinnerId) {
                            let winnerIdx = newPlayers.findIndex(p => p.id === data.trickWinnerId);
                            if (winnerIdx !== -1) {
                                if (newPlayers[winnerIdx].finishedRank === null) {
                                    nextTurn = winnerIdx;
                                } else {
                                    // Winner is already finished, turn passes to next active player
                                    nextTurn = getNextTurn(winnerIdx, newPlayers);
                                }
                            }
                        }
                        tableStatus = "場が流れました";
                    }

                    transaction.update(roomDocRef, {
                        players: newPlayers,
                        turnIndex: nextTurn,
                        passCount: newPassCount,
                        table: newTable,
                        tableStatus: tableStatus
                    });
                });
            } catch (e) {
                showToast("エラーが発生しました");
            }
        }

        function isValidPlay(selected, table, isRev) {
            if (selected.length === 0) return false;
            
            // Validate selected cards combination (must be same rank or include Joker)
            let nonJokers = selected.filter(c => c.suit !== 'JOKER');
            if (nonJokers.length > 0) {
                let targetRank = nonJokers[0].rank;
                if (!nonJokers.every(c => c.rank === targetRank)) return false;
            }
            
            // Get strength of the play (determined by non-jokers, or joker if all jokers)
            let playStrength = selected[0].suit === 'JOKER' ? 99 : getCardStrength(nonJokers[0], isRev);
            
            // If table is empty, valid
            if (!table || table.length === 0) return true;
            
            // If table has cards, must match quantity
            if (selected.length !== table.length) return false;
            
            // Must be stronger than table
            let tableStrength = getCardStrength(table[0], isRev); 
            // Note: in real daifugo, Joker played alone is strong, played with others takes their strength.
            // Simplified: playStrength must be > tableStrength
            // Handle table Joker: if table is Joker (99), you can't beat it (unless Spades 3 local rule, omitting for simplicity)
            return playStrength > tableStrength;
        }

        async function handlePlay() {
            if (!roomState || roomState.players[roomState.turnIndex].id !== userId) return;
            if (selectedCards.length === 0) {
                showToast("カードを選択してください");
                return;
            }
            
            if (!isValidPlay(selectedCards, roomState.table, roomState.isRevolution)) {
                showToast("そのカードは出せません");
                return;
            }

            try {
                await runTransaction(db, async (transaction) => {
                    const roomDoc = await transaction.get(roomDocRef);
                    let data = roomDoc.data();
                    let newPlayers = [...data.players];
                    let myIdx = data.turnIndex;
                    let me = newPlayers[myIdx];
                    
                    // Remove selected from hand
                    selectedCards.forEach(sc => {
                        let idx = me.cards.findIndex(c => c.suit === sc.suit && c.rank === sc.rank);
                        if (idx > -1) me.cards.splice(idx, 1);
                    });
                    
                    let newTable = [...selectedCards];
                    let isRev = data.isRevolution;
                    let nextTurn = getNextTurn(data.turnIndex, newPlayers);
                    let newPassCount = 0;
                    let statusMsg = "";
                    let tableCleared = false;
                    
                    // Reset pass flags
                    newPlayers.forEach(p => p.passed = false);

                    // Check Revolution (4 or more cards)
                    if (selectedCards.length >= 4) {
                        isRev = !isRev;
                        statusMsg = "革命！！";
                    }

                    // Check 8-stop
                    let is8Stop = selectedCards.some(c => c.rank === 8 && c.suit !== 'JOKER');
                    if (is8Stop) {
                        statusMsg = "8切り！";
                        tableCleared = true;
                        newTable = [];
                        nextTurn = myIdx; // Keep turn
                    }

                    // Check if player finished
                    if (me.cards.length === 0) {
                        let currentRanks = newPlayers.filter(p => p.finishedRank !== null).length;
                        me.finishedRank = currentRanks + 1;
                        if (is8Stop) {
                            nextTurn = getNextTurn(myIdx, newPlayers); // 8-stop but finished
                        }
                    }

                    let activePlayers = newPlayers.filter(p => p.finishedRank === null);
                    let newStatus = data.status;
                    
                    // Check game end (only 1 player left)
                    if (activePlayers.length <= 1) {
                        newStatus = 'finished';
                        if (activePlayers.length === 1) {
                            activePlayers[0].finishedRank = newPlayers.length; // Last place
                        }
                    }

                    transaction.update(roomDocRef, {
                        players: newPlayers,
                        table: newTable,
                        turnIndex: nextTurn,
                        isRevolution: isRev,
                        passCount: newPassCount,
                        trickWinnerId: userId,
                        status: newStatus,
                        tableStatus: statusMsg
                    });
                });
                
                selectedCards = []; // clear local selection
                
            } catch (e) {
                console.error(e);
                showToast("エラーが発生しました");
            }
        }

        // Render HTML based on state
        function render() {
            if (!roomState) return;

            // Screen management
            if (roomState.status === 'waiting') {
                document.getElementById('lobby-screen').style.display = 'flex';
                document.getElementById('game-screen').classList.add('hidden');
                
                // Update lobby list
                const list = document.getElementById('player-list');
                list.innerHTML = '';
                roomState.players.forEach(p => {
                    const li = document.createElement('li');
                    li.className = 'text-white text-lg bg-gray-700 p-2 rounded';
                    li.textContent = p.name + (p.id === userId ? ' (あなた)' : '');
                    list.appendChild(li);
                });
                document.getElementById('player-count').textContent = roomState.players.length;
                
                const isHost = roomState.players.length > 0 && roomState.players[0].id === userId;
                const startBtn = document.getElementById('start-btn');
                const waitingMsg = document.getElementById('waiting-msg');
                
                if (isHost && roomState.players.length >= 2) {
                    startBtn.classList.remove('hidden');
                    waitingMsg.classList.add('hidden');
                } else {
                    startBtn.classList.add('hidden');
                    waitingMsg.classList.remove('hidden');
                }
                
                document.getElementById('modal-overlay').classList.remove('active');
            } else {
                document.getElementById('lobby-screen').style.display = 'none';
                document.getElementById('game-screen').classList.remove('hidden');
                renderGame();
            }
        }

        function getSuitIcon(suit) {
            switch(suit) {
                case 'S': return '♠';
                case 'H': return '♥';
                case 'D': return '♦';
                case 'C': return '♣';
                default: return '';
            }
        }
        function getRankText(rank) {
            if (rank === 1) return 'A';
            if (rank === 11) return 'J';
            if (rank === 12) return 'Q';
            if (rank === 13) return 'K';
            return rank;
        }

        function createCardElement(card, onClick) {
            const div = document.createElement('div');
            div.className = `card ${card.suit === 'H' || card.suit === 'D' ? 'red' : 'black'}`;
            if (card.suit === 'JOKER') {
                div.classList.add('joker');
                div.innerHTML = `<span>JOKER</span>`;
            } else {
                const suitIcon = getSuitIcon(card.suit);
                const rankText = getRankText(card.rank);
                div.innerHTML = `
                    <div class="flex justify-between w-full">
                        <span class="rank">${rankText}</span>
                        <span class="suit">${suitIcon}</span>
                    </div>
                    <div class="text-4xl text-center opacity-50">${suitIcon}</div>
                    <div class="flex justify-between w-full rank-bottom">
                        <span class="rank">${rankText}</span>
                        <span class="suit">${suitIcon}</span>
                    </div>
                `;
            }
            if (onClick) {
                div.onclick = () => onClick(div, card);
                // Maintain visual selection
                if (selectedCards.some(sc => sc.suit === card.suit && sc.rank === card.rank)) {
                    div.classList.add('selected');
                }
            }
            return div;
        }

        function getRankName(rankNum) {
            switch(rankNum) {
                case 1: return "大富豪";
                case 2: return "富豪";
                case 3: return "平民";
                case 4: return "大貧民";
                default: return "";
            }
        }

        function renderGame() {
            // Revolution UI
            const revIndicator = document.getElementById('revolution-indicator');
            if (roomState.isRevolution) revIndicator.classList.remove('hidden');
            else revIndicator.classList.add('hidden');

            const isMyTurn = roomState.players[roomState.turnIndex]?.id === userId;
            
            // Opponents
            const oppContainer = document.getElementById('opponents-container');
            oppContainer.innerHTML = '';
            roomState.players.forEach((p, idx) => {
                if (p.id === userId) return; // Skip self
                const isTurn = roomState.turnIndex === idx;
                const div = document.createElement('div');
                div.className = `player-info ${isTurn ? 'active-turn' : ''} ${p.passed ? 'opacity-50' : ''}`;
                
                let rankStr = p.finishedRank ? `<div class="text-yellow-400 text-xs">${getRankName(p.finishedRank)}</div>` : '';
                let passedStr = p.passed && !p.finishedRank ? `<div class="text-red-400 text-xs">PASS</div>` : '';
                
                div.innerHTML = `
                    <div class="font-bold text-gray-200 text-sm overflow-hidden text-ellipsis whitespace-nowrap w-24 mx-auto">${p.name}</div>
                    <div class="text-xs">残り: ${p.cards ? p.cards.length : 0}枚</div>
                    ${rankStr}
                    ${passedStr}
                `;
                oppContainer.appendChild(div);
            });

            // Self Info
            const meIdx = roomState.players.findIndex(p => p.id === userId);
            const me = roomState.players[meIdx];
            if (me) {
                document.getElementById('my-name').textContent = me.name;
                document.getElementById('my-card-count').textContent = me.cards.length;
                document.getElementById('my-player-info').className = `player-info ${isMyTurn ? 'active-turn' : ''}`;
                
                if (me.finishedRank) {
                    const rankEl = document.getElementById('my-rank');
                    rankEl.textContent = getRankName(me.finishedRank);
                    rankEl.classList.remove('hidden');
                }
            }

            // Game Message
            const msgEl = document.getElementById('game-message');
            if (roomState.status === 'finished') {
                msgEl.textContent = "ゲーム終了！";
                showResultModal();
            } else if (isMyTurn) {
                msgEl.textContent = "あなたのターンです";
                msgEl.classList.add('text-yellow-400');
                msgEl.classList.remove('text-blue-300');
            } else {
                msgEl.textContent = `${roomState.players[roomState.turnIndex]?.name} のターン`;
                msgEl.classList.add('text-blue-300');
                msgEl.classList.remove('text-yellow-400');
            }

            // Action Buttons
            const playBtn = document.getElementById('play-btn');
            const passBtn = document.getElementById('pass-btn');
            if (isMyTurn && !me.finishedRank) {
                playBtn.disabled = false;
                passBtn.disabled = false;
            } else {
                playBtn.disabled = true;
                passBtn.disabled = true;
            }

            // Table Status
            const tableMsgEl = document.getElementById('table-status-msg');
            if (roomState.tableStatus) {
                tableMsgEl.textContent = roomState.tableStatus;
                // Fade out after a bit
                setTimeout(() => { if (tableMsgEl.textContent === roomState.tableStatus) tableMsgEl.textContent = ''; }, 3000);
            }

            // Table Cards
            const tableContainer = document.getElementById('table-cards');
            tableContainer.innerHTML = '';
            if (roomState.table && roomState.table.length > 0) {
                roomState.table.forEach(card => {
                    tableContainer.appendChild(createCardElement(card));
                });
            } else {
                tableContainer.innerHTML = `<div class="text-gray-500 font-bold border-2 border-dashed border-gray-600 rounded-xl p-8 flex items-center justify-center">場には何もありません</div>`;
            }

            // My Hand
            const handContainer = document.getElementById('my-hand');
            handContainer.innerHTML = '';
            if (me && me.cards) {
                me.cards.forEach(card => {
                    handContainer.appendChild(createCardElement(card, (el, c) => {
                        if (!isMyTurn || me.finishedRank) return;
                        
                        const idx = selectedCards.findIndex(sc => sc.suit === c.suit && sc.rank === c.rank);
                        if (idx > -1) {
                            selectedCards.splice(idx, 1);
                            el.classList.remove('selected');
                        } else {
                            // Only allow selecting same rank or joker
                            if (selectedCards.length > 0 && c.suit !== 'JOKER' && !selectedCards.every(sc => sc.suit === 'JOKER' || sc.rank === c.rank)) {
                                // Reset selection if selecting a different rank
                                selectedCards = [];
                                document.querySelectorAll('#my-hand .card').forEach(n => n.classList.remove('selected'));
                            }
                            selectedCards.push(c);
                            el.classList.add('selected');
                        }
                    }));
                });
            }
        }

        function showResultModal() {
            const overlay = document.getElementById('modal-overlay');
            if (overlay.classList.contains('active')) return;
            
            const list = document.getElementById('result-list');
            list.innerHTML = '';
            
            // Sort by finishedRank
            const sorted = [...roomState.players].sort((a, b) => (a.finishedRank || 99) - (b.finishedRank || 99));
            
            sorted.forEach(p => {
                const div = document.createElement('div');
                div.className = `p-3 rounded font-bold ${p.id === userId ? 'bg-yellow-600/30 border border-yellow-500' : 'bg-gray-700'}`;
                div.innerHTML = `<span class="text-yellow-400 mr-4 w-16 inline-block">${getRankName(p.finishedRank)}</span> ${p.name}`;
                list.appendChild(div);
            });
            
            overlay.classList.add('active');
        }

        // Boot
        window.addEventListener('DOMContentLoaded', initAuth);

    </script>
</body>
</html>